default_platform(:ios)

PROJECT = "CurrencyConverter.xcodeproj".freeze
SCHEME  = "CurrencyConverter".freeze
TEAM_ID = "N9SGQL8822".freeze

# Signable targets that ship inside the .ipa, each mapped to its bundle id.
# (CurrencyCore / Subscriptions are frameworks — they get no profile.)
SIGNABLE = {
  "CurrencyConverter"   => "gmg.CurrencyConverter",
  "ListWidgetExtension" => "gmg.CurrencyConverter.ListWidget",
  "WidgetIntent"        => "gmg.CurrencyConverter.WidgetIntent",
}.freeze

# IDFA / advertising answers for the App Store review questionnaire.
# This app integrates Google AdMob (GADApplicationIdentifier in Info.plist) and
# asks for App Tracking Transparency, so it DOES use the advertising identifier.
# These are compliance attestations — confirm they match how you actually use ads
# before relying on the automated `release` lane.
IDFA_SUBMISSION = {
  add_id_info_uses_idfa:       true,
  add_id_info_serves_ads:      true,
  add_id_info_tracks_install:  false,
  add_id_info_tracks_action:   false,
  add_id_info_limits_tracking: true,
}.freeze

platform :ios do
  desc "Build a signed Release archive and upload it to TestFlight"
  lane :beta do
    build_and_upload(wait_for_processing: false)
  end

  desc "Build, upload, and submit to App Store review (run on a vX.Y.Z tag)"
  lane :release do
    api_key = build_and_upload(wait_for_processing: true)

    # Attach the build we just uploaded to the App Store version and submit it.
    # Metadata + screenshots are assumed already prepared in App Store Connect
    # for this version (see fastlane/DEPLOY.md) — we only attach + submit here.
    upload_to_app_store(
      api_key:            api_key,
      submit_for_review:  true,
      skip_binary_upload: true,  # binary already went up via TestFlight
      skip_screenshots:   true,  # managed in App Store Connect
      skip_metadata:      true,  # managed in App Store Connect
      precheck_include_in_app_purchases: false,
      force:              true,  # no interactive HTML-report confirmation
      submission_information: IDFA_SUBMISSION.merge(
        # Info.plist already declares ITSAppUsesNonExemptEncryption=false.
        export_compliance_uses_encryption: false,
      ),
    )
  end

  # Shared: sign, set version/build number, archive, push to TestFlight.
  # Returns the api_key so callers can reuse it. `wait_for_processing` must be
  # true before a build can be submitted for review.
  private_lane :build_and_upload do |options|
    api_key = app_store_connect_api_key(
      key_id:                ENV.fetch("ASC_KEY_ID"),
      issuer_id:             ENV.fetch("ASC_ISSUER_ID"),
      key_content:           ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
    )

    # Fresh CI runner: create + unlock a temporary keychain to import the cert into.
    setup_ci if is_ci

    # Pull the distribution cert + App Store profiles for all three bundle ids.
    # readonly: never mint new certs/profiles from CI (that would burn Apple's cap);
    # populate them once locally with `bundle exec fastlane match appstore`.
    match(type: "appstore", readonly: true, api_key: api_key)

    # Pin manual signing per target so the archive is reproducible in CI.
    SIGNABLE.each do |target, bundle_id|
      update_code_signing_settings(
        path:                  PROJECT,
        targets:               [target],
        use_automatic_signing: false,
        team_id:               TEAM_ID,
        code_sign_identity:    "Apple Distribution",
        profile_name:          "match AppStore #{bundle_id}",
      )
    end

    # On a tag push the workflow passes APP_VERSION (e.g. "1.2.0" from tag v1.2.0);
    # set the marketing version to match so the right App Store version is submitted.
    app_version = ENV["APP_VERSION"].to_s
    unless app_version.empty?
      increment_version_number(xcodeproj: PROJECT, version_number: app_version)
    end

    # Unique, monotonic build number — GitHub run number in CI, commit count locally.
    # apple-generic versioning + GENERATE_INFOPLIST_FILE flows this into CFBundleVersion.
    increment_build_number(
      xcodeproj:    PROJECT,
      build_number: ENV["GITHUB_RUN_NUMBER"] || number_of_commits.to_s,
    )

    build_app(
      project:       PROJECT,
      scheme:        SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: SIGNABLE.transform_values { |id| "match AppStore #{id}" },
      },
    )

    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: !options[:wait_for_processing],
    )

    api_key
  end
end
